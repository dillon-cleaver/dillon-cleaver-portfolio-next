{
  "compilerOptions": {
    "target": "es5",
    "lib": ["es2015", "dom"],
    "types": ["cypress", "node"],
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["*", "app/*"]
    }
  },
  "include": ["**/*.ts", "../cypress.config.ts"],
  "exclude": ["../node_modules"]
}
